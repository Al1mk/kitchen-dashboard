# Copy is created by `npm run admin:set-password` as .env.local (git-ignored).
# Never commit real values.

# Demo administrator (no defaults: login stays disabled until set)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional: SQLite file location (default: ./data/campus-board.sqlite)
# CAMPUS_BOARD_DB_PATH=

# Optional, LAN demo only: allow the admin session cookie over plain HTTP when
# the admin is opened via an IP address instead of localhost. Not for real use.
# CAMPUS_BOARD_INSECURE_COOKIES=true
